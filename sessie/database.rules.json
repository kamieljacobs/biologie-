{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'"
      }
    },
    "sessies": {
      ".read": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'"
      }
    },
    "deelnemers": {
      "$code": {
        ".read": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('sessies').child($code).child('status').exists() && root.child('sessies').child($code).child('status').val() !== 'dicht'",
          ".validate": "newData.child('naam').isString() && newData.child('naam').val().length > 0 && newData.child('naam').val().length <= 30"
        }
      }
    },
    "antwoorden": {
      "$code": {
        ".read": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('sessies').child($code).child('status').exists() && root.child('sessies').child($code).child('status').val() !== 'dicht'",
          "$opdracht": {
            "tekst": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "eerste": {
              "tekst": {
                ".validate": "newData.isString() && newData.val().length <= 4000"
              }
            },
            "laatste": {
              "tekst": {
                ".validate": "newData.isString() && newData.val().length <= 4000"
              }
            }
          }
        }
      }
    },
    "feedback": {
      ".read": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
      ".indexOn": [
        "tijd"
      ],
      "$id": {
        ".write": "(auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2') || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['soort', 'tekst', 'pagina', 'status', 'tijd'])",
        "soort": {
          ".validate": "newData.isString() && newData.val().matches(/^(fout|onduidelijk|idee|compliment)$/)"
        },
        "tekst": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
        },
        "naam": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "pagina": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "titel": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "plek": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "scherm": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "thema": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "notitie": {
          ".validate": "(auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2') && newData.isString() && newData.val().length <= 2000"
        },
        "status": {
          ".validate": "newData.val() === 'nieuw' || ((auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2') && newData.val() === 'verwerkt')"
        },
        "tijd": {
          ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
        },
        "$anders": {
          ".validate": false
        }
      }
    },
    "review": {
      ".read": true,
      ".indexOn": [
        "film",
        "status",
        "tijd"
      ],
      "$id": {
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        ".validate": "newData.hasChildren(['film', 't', 'tekst', 'status', 'tijd'])",
        "film": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "tekst": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 2000"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "zin": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "status": {
          ".validate": "newData.val() === 'nieuw' || newData.val() === 'verwerkt'"
        },
        "tijd": {
          ".validate": "newData.isNumber()"
        },
        "$anders": {
          ".validate": false
        }
      }
    },
    "reviewstatus": {
      ".read": true,
      "$film": {
        ".write": "auth != null && auth.uid === 'wZevu7kFPFd7iSloWPXIzyqKQ7m2'",
        ".validate": "newData.hasChildren(['href', 'status', 'tijd'])",
        "href": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "status": {
          ".validate": "newData.val() === 'bekeken' || newData.val() === 'ok' || newData.val() === 'open'"
        },
        "tijd": {
          ".validate": "newData.isNumber()"
        },
        "$anders": {
          ".validate": false
        }
      }
    }
  }
}
