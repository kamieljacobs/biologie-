{"words": [{"text": "Zenuwachtig", "start": 0.0, "end": 0.64, "type": "word"}, {"text": "zijn", "start": 0.72, "end": 1.04, "type": "word"}, {"text": "is", "start": 1.16, "end": 1.28, "type": "word"}, {"text": "geen", "start": 1.36, "end": 1.52, "type": "word"}, {"text": "zwakte.", "start": 1.6, "end": 2.56, "type": "word"}, {"text": "Bijna", "start": 2.6, "end": 2.96, "type": "word"}, {"text": "iedereen", "start": 3.04, "end": 3.52, "type": "word"}, {"text": "kent", "start": 3.6, "end": 3.76, "type": "word"}, {"text": "het.", "start": 3.84, "end": 4.48, "type": "word"}, {"text": "Mevrouw", "start": 4.52, "end": 4.8, "type": "word"}, {"text": "Visser", "start": 4.88, "end": 5.2, "type": "word"}, {"text": "vertelt:", "start": 5.32, "end": 6.08, "type": "word"}, {"text": "\"Voor", "start": 6.12, "end": 6.24, "type": "word"}, {"text": "mijn", "start": 6.32, "end": 6.48, "type": "word"}, {"text": "eerste", "start": 6.56, "end": 6.8, "type": "word"}, {"text": "les", "start": 6.88, "end": 7.2, "type": "word"}, {"text": "bonkte", "start": 7.28, "end": 7.52, "type": "word"}, {"text": "mijn", "start": 7.56, "end": 7.68, "type": "word"}, {"text": "hart", "start": 7.76, "end": 8.0, "type": "word"}, {"text": "ook.\"", "start": 8.08, "end": 8.64, "type": "word"}], "text": "Zenuwachtig zijn is geen zwakte. Bijna iedereen kent het. Mevrouw Visser vertelt: \"Voor mijn eerste les bonkte mijn hart ook.\"", "scribe_gelijk": true}